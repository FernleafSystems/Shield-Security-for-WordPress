{% set panel_id = panel.id %}
{% set panel_status = panel.status %}
{% set panel_class = panel.class %}
{% set panel_is_open = panel.is_open %}
{% set panel_spacing_top = panel.spacing_top %}

<section id="{{ panel_id }}"
		 class="card shield-card{% if panel_spacing_top != 'none' %} mt-3{% endif %} status-{{ panel_status }}{% if not panel_is_open %} d-none{% endif %}{% if panel_class is not empty %} {{ panel_class }}{% endif %}"
		 data-mode-panel="1"
		 data-mode-panel-target="{{ panel.target }}"
		 {% if panel.target_default is not empty %}
		 data-mode-panel-target-default="{{ panel.target_default }}"
		 {% endif %}
		 {% if panel.static_target %}
		 data-mode-panel-static-target="1"
		 {% endif %}
		 {% for data_key, data_value in panel.data %}
		 data-{{ data_key|e('html_attr') }}="{{ data_value|e('html_attr') }}"
		 {% endfor %}
		 aria-hidden="{{ panel_is_open ? 'false' : 'true' }}">
	<div class="shield-card-accent status-{{ panel_status }}"></div>
	<div class="card-body">
		<div class="d-flex justify-content-between align-items-center mb-2">
			<div class="d-flex align-items-center gap-2">
				<h3 class="card-title h5 mb-0" data-mode-panel-title>{{ panel.title }}</h3>
				{% if panel.badge_label is not empty %}
					<span class="{{ panel.badge_class }}">{{ panel.badge_label }}</span>
				{% endif %}
			</div>
			<button type="button"
					class="mode-panel-close-btn"
					data-mode-panel-close="1"
					aria-label="{{ strings.mode_panel_close }}">&times;</button>
		</div>
		<div data-mode-panel-body>
			{{ panel.body|raw }}
		</div>
	</div>
</section>
