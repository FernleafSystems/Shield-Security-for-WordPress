{% import '/common/macros.twig' as icwp_macros %}

<div class="shield-detail-row shield-detail-row--{{ row.status }}{% if row.expandable %} shield-detail-row--expandable{% endif %}"
	 {{ icwp_macros.renderAttributes(row.attributes) }}
	 {% if row.expandable %}
	 data-shield-expand-row="1"
	 data-shield-expand-target="{{ row.expand_target|e('html_attr') }}"
	 {% endif %}>
	<div class="shield-detail-row__icons">
		<span class="shield-detail-row__status-icon shield-detail-row__status-icon--{{ row.status }}"
			  role="img"
			  aria-label="{{ row.status_label|e('html_attr') }}">
			<i class="{{ row.status_icon }}"></i>
		</span>
	</div>

	<div class="shield-detail-row__copy">
		<div class="shield-detail-row__heading">
			<span class="shield-detail-row__title">{{ row.title }}</span>
			{% if row.count_badge > 0 %}
				<span class="shield-badge badge-{{ row.badge_status }}">{{ row.count_badge }}</span>
			{% endif %}
		</div>

		{% if row.description is not empty %}
			<div class="shield-detail-row__desc">{{ row.description }}</div>
		{% endif %}

		{% if row.explanations is not empty %}
			<ul class="shield-detail-row__explanations">
				{% for explanation in row.explanations %}
					{% set explanation_action = row.explanation_actions[ loop.index0 ] %}
					<li>
						{% if row.status in [ 'warning', 'critical' ] %}
							<span class="shield-detail-row__expl-icon" aria-hidden="true">
								<i class="bi bi-exclamation-circle-fill"></i>
							</span>
						{% endif %}
						<span>{{ explanation }}</span>
						{% if explanation_action is not null %}
							<button type="button"
									class="shield-detail-row__expl-action"{{ icwp_macros.renderAttributes( explanation_action.attributes ) }}>{{ explanation_action.label }}</button>
						{% endif %}
					</li>
				{% endfor %}
			</ul>
		{% endif %}

		{% if row.actions is not empty %}
			<div class="shield-detail-row__actions">
				{% for action in row.actions %}
					{% if action.is_action %}
						<button type="button"
								class="shield-action-chip shield-action-chip--{{ action.type }}"{% if action.tooltip is not empty %}
								data-bs-toggle="tooltip"
								data-bs-title="{{ action.tooltip|e('html_attr') }}"{% endif %}{{ icwp_macros.renderAttributes(action.attributes) }}>
							<i class="{{ action.icon }}"></i>
							{{ action.label }}
						</button>
					{% elseif action.href is not empty %}
						<a href="{{ action.href }}"
						   class="shield-action-chip shield-action-chip--{{ action.type }}"{% if action.tooltip is not empty %}
						   data-bs-toggle="tooltip"
						   data-bs-title="{{ action.tooltip|e('html_attr') }}"{% endif %}{{ icwp_macros.renderAttributes(action.attributes) }}>
							<i class="{{ action.icon }}"></i>
							{{ action.label }}
						</a>
					{% endif %}
				{% endfor %}
			</div>
		{% endif %}
	</div>

	{% if row.expandable %}
		<div class="shield-detail-row__end">
			<button type="button"
					class="shield-detail-row__expand-toggle"
					data-shield-expand-trigger="1"
					aria-controls="{{ row.expand_target|e('html_attr') }}"
					aria-expanded="false"
					aria-label="{{ row.expand_accessible_label|e('html_attr') }}"{% if row.expand_title is not empty %}
					title="{{ row.expand_title|e('html_attr') }}"{% endif %}>
				{% if row.expand_cta_label is not empty %}
					<span class="shield-detail-row__expand-cta" aria-hidden="true">{{ row.expand_cta_label }}</span>
				{% else %}
					<span class="visually-hidden">{{ row.expand_accessible_label }}</span>
				{% endif %}
				<i class="bi bi-chevron-right shield-detail-row__chevron" aria-hidden="true"></i>
			</button>
		</div>
	{% endif %}
</div>
