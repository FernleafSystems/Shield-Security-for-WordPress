{# A subject opens flat beneath the lookup: its name, its tabs, and its tables, with no box around them. #}
<section class="investigate-landing__subject-panel"
		 data-investigate-panel="1"
		 data-investigate-panel-subject="{{ panel.subject_key }}"
		 data-investigate-panel-loaded="{{ panel.is_loaded }}"
		 data-investigate-panel-live="{{ panel.is_live }}"
		 data-investigate-render-action="{{ panel.render_action_json|e('html_attr') }}">
	<div class="investigate-landing__subject-body">
		<div data-investigate-panel-header="1"></div>
		<div class="investigate-panel__tabs" data-investigate-panel-tabs="1"></div>
		<div data-investigate-panel-content="1" aria-busy="false">
			{{ panel.body|raw }}
		</div>
	</div>
</section>
