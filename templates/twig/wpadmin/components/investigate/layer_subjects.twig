{#
	Investigate's lookup: one search for users, IP addresses, plugins, themes and WordPress core. Results
	are grouped by kind and open that subject's panel in place. The kind buttons narrow the search to one kind;
	with nothing typed, a kind is listed to browse. Each kind carries its subject, so its results open the
	same panel its tile used to.
#}
<div class="investigate-lookup"
	 data-investigate-lookup="1"
	 data-lookup-action="{{ lookup_action_json|e('html_attr') }}"
	 data-lookup-strings="{{ {
		 searching: strings.lookup_searching,
		 none: strings.lookup_none,
		 none_kind: strings.lookup_none_kind,
		 count: strings.lookup_count,
		 count_one: strings.lookup_count_one,
		 failed: strings.lookup_failed
	 }|json_encode|e('html_attr') }}">

	<div class="investigate-lookup__box">
		<i class="bi bi-search" aria-hidden="true"></i>
		<label class="screen-reader-text" for="InvestigateLookupInput">{{ strings.lookup_label }}</label>
		<input type="search"
			   id="InvestigateLookupInput"
			   class="investigate-lookup__input"
			   placeholder="{{ strings.lookup_placeholder }}"
			   autocomplete="off"
			   spellcheck="false"
			   aria-controls="InvestigateLookupResults"
			   data-lookup-input="1" />
	</div>

	<div class="investigate-lookup__kinds" role="group" aria-labelledby="InvestigateLookupKindsLabel">
		<span class="visually-hidden" id="InvestigateLookupKindsLabel">{{ strings.lookup_kinds_label }}</span>
		<button type="button" class="investigate-lookup__kind" data-lookup-kind="any" aria-pressed="true">{{ strings.lookup_kind_any }}</button>
		{% for kind in kinds %}
			<button type="button"
					class="investigate-lookup__kind"
					data-lookup-kind="{{ kind.key }}"
					aria-pressed="false"
					{% for attr, value in kind.attributes %} {{ attr }}="{{ value|e('html_attr') }}"{% endfor %}>{{ kind.label }}</button>
		{% endfor %}
	</div>

	<p class="investigate-lookup__intro" data-lookup-intro="1">{{ strings.lookup_intro }}</p>
	<div class="investigate-lookup__status" role="status" aria-live="polite" data-lookup-status="1"></div>
	<div class="investigate-lookup__results" id="InvestigateLookupResults" data-lookup-results="1"></div>
</div>
