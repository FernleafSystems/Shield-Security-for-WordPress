<div class="investigate-landing__subjects">
	<section class="investigate-landing__subject-section">
		<div class="investigate-landing__section-heading">
			<span class="investigate-landing__section-icon" aria-hidden="true"><i class="bi bi-compass"></i></span>
			<h2 class="investigate-landing__section-label">{{ strings.explore_heading }}</h2>
		</div>
		<div class="investigate-landing__subject-grid">
			{% for subject in subjects %}
			{% if subject.is_enabled %}
				<article class="investigate-landing__subject-card operator-card-surface operator-tile-card status-{{ subject.status }}"
						 data-drill-target="panel"
						 data-investigate-subject="{{ subject.key }}"
						 data-investigate-header="{{ subject.header_json }}"
						 data-investigate-render-action="{{ subject.render_action_json }}"
						 data-investigate-lookup-key="{{ subject.lookup_key }}"
						 data-investigate-is-live="{{ subject.is_live_attr }}">
					<div class="operator-tile-card__main">
						<span class="operator-tile-card__icon" aria-hidden="true">
							<i class="{{ subject.icon_class }}"></i>
						</span>
						<span class="operator-tile-card__copy">
							<span class="operator-tile-card__title">
								{{ subject.title }}
								{% if subject.is_pro %}
									<span class="shield-badge badge-warning">{{ strings.label_pro }}</span>
								{% endif %}
							</span>
							<span class="operator-tile-card__summary">{{ subject.stat_text }}</span>
						</span>
					</div>
					<div class="operator-tile-card__actions">
						<button type="button"
								class="operator-tile-card__action operator-tile-card__action--primary"
								data-investigate-primary-action="1">
							{{ subject.primary_action_label }}
						</button>
						{% if subject.key == 'ip' %}
							<a href="{{ subject.ip_rules_href }}"
							   class="operator-tile-card__action operator-tile-card__action--secondary"
							   data-investigate-manage-ip-rules="1">
								{{ strings.manage_ip_rules }}
							</a>
						{% endif %}
					</div>
				</article>
			{% else %}
				<div class="investigate-landing__subject-card operator-card-surface operator-tile-card is-disabled status-{{ subject.status }}"
					 data-investigate-subject="{{ subject.key }}"
					 aria-disabled="true">
					<span class="operator-tile-card__main">
						<span class="operator-tile-card__icon" aria-hidden="true">
							<i class="{{ subject.icon_class }}"></i>
						</span>
						<span class="operator-tile-card__copy">
							<span class="operator-tile-card__title">
								{{ subject.title }}
								{% if subject.is_pro %}
									<span class="shield-badge badge-warning">{{ strings.label_pro }}</span>
								{% endif %}
							</span>
							<span class="operator-tile-card__summary">{{ subject.stat_text }}</span>
						</span>
					</span>
				</div>
			{% endif %}
			{% endfor %}
		</div>
	</section>

	<section class="investigate-landing__subject-section">
		<div class="investigate-landing__section-heading">
			<span class="investigate-landing__section-icon" aria-hidden="true"><i class="bi bi-journal-text"></i></span>
			<h2 class="investigate-landing__section-label">{{ strings.review_activity_heading }}</h2>
		</div>
		<div class="investigate-landing__subject-grid">
			{% for review in activity_reviews %}
				<a href="{{ review.href }}"
				   class="investigate-landing__subject-card operator-card-surface operator-tile-card status-info"
				   aria-label="{{ review.action_label }}">
					<span class="operator-tile-card__main">
						<span class="operator-tile-card__icon" aria-hidden="true">
							<i class="{{ review.icon_class }}"></i>
						</span>
						<span class="operator-tile-card__copy">
							<span class="operator-tile-card__title">{{ review.title }}</span>
							<span class="operator-tile-card__summary">{{ review.stat_text }}</span>
						</span>
					</span>
					<span class="operator-tile-card__actions">
						<span class="operator-tile-card__action operator-tile-card__action--primary">
							{{ review.action_label }}
						</span>
					</span>
				</a>
			{% endfor %}
		</div>
	</section>
</div>
