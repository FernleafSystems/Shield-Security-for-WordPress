{% set overview_rows = rows %}

<section class="investigate-flat-section investigate-overview-table">
	{% if title is not empty %}
		<h3 class="mb-3 investigate-section-title">{{ title }}</h3>
	{% endif %}

	{% if overview_rows is empty %}
		<div class="small text-muted mb-0">No overview data is available for this subject.</div>
	{% else %}
		<div class="table-responsive">
			<table class="table table-sm mb-0">
				<tbody>
				{% for row in overview_rows %}
					<tr>
						<th class="w-25">{{ row.label }}</th>
						<td>
							{% if row.value_href is not empty %}
								<a href="{{ row.value_href }}" target="_blank" rel="noopener noreferrer">{{ row.value }}</a>
							{% else %}
								{{ row.value }}
							{% endif %}
						</td>
					</tr>
				{% endfor %}
				</tbody>
			</table>
		</div>
	{% endif %}
</section>
