<div class="actions-queue-buckets shield-stack">
	<div class="actions-queue-buckets__grid">
		{% for bucket in buckets %}
			<button type="button"
					class="actions-queue-bucket-card operator-card-surface operator-tile-card status-{{ bucket.status }}"
					data-drill-target="groups"
					data-drill-bucket-selection="{{ bucket.selection.selection_json }}"
					{% if not bucket.is_interactive %}disabled{% endif %}>
				<div class="operator-tile-card__main">
					<span class="operator-tile-card__icon">
						<i class="{{ bucket.icon_class }}" aria-hidden="true"></i>
					</span>
					<div class="operator-tile-card__copy">
						<div class="actions-queue-bucket-card__severity operator-tile-card__status">
							<span class="actions-queue-bucket-card__severity-label">{{ bucket.state_label }}</span>
							<span class="actions-queue-bucket-card__count">{{ bucket.display_count }}</span>
						</div>
						<span class="actions-queue-bucket-card__title operator-tile-card__title">{{ bucket.label }}</span>
					</div>
				</div>
				<p class="actions-queue-bucket-card__summary operator-tile-card__summary">{{ bucket.summary_text }}</p>
			</button>
		{% endfor %}
	</div>
	{% if healthy_rows is not empty %}
		<div class="item-box item-box--good">
			<div class="item-box__grid">
				{% for row in healthy_rows %}
					{% include '/wpadmin/components/actions_queue/compact_summary_row.twig' with {
						row: row
					} only %}
				{% endfor %}
			</div>
		</div>
	{% endif %}
</div>
