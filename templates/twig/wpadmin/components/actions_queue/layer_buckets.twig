{#
	The Actions Queue landing, following the approved concept: each lane that needs action is one card
	with a tinted header and a flat list of rows, and a row opens its results directly. Checks that are
	passing, and checks the plan doesn't cover or that are turned off, each get one section of their own
	at the end. The same sections can show as tabs instead.
#}
{% set view = view|default('sections') %}
{% set lanes = [] %}
{% set passing = [] %}
{% set not_covered = [] %}
{% for bucket in buckets|filter( b => b.is_interactive ) %}
	{% set layer = bucket_groups[ bucket.key ]|default( {} ) %}
	{% set lane_sections = [] %}
	{% set tagged_sections = layer.active_sections|default( [] )|map( s => s|merge( { is_healthy: false } ) )
		|merge( layer.healthy_sections|default( [] )|map( s => s|merge( { is_healthy: true } ) ) ) %}
	{% for group_section in tagged_sections %}
		{% set lane_groups = [] %}
		{% for group in group_section.groups %}
			{% set entry = { group: group, bucket_selection: layer.bucket_selection } %}
			{% if group.is_pro_upsell or group.enable_dialog_json is not empty %}
				{% set not_covered = not_covered|merge( [ entry ] ) %}
			{% elseif group.status == 'good' or group_section.is_healthy %}
				{% set passing = passing|merge( [ entry ] ) %}
			{% else %}
				{% set lane_groups = lane_groups|merge( [ group ] ) %}
			{% endif %}
		{% endfor %}
		{% if lane_groups is not empty %}
			{% set lane_sections = lane_sections|merge( [ { heading: group_section.heading_label, groups: lane_groups } ] ) %}
		{% endif %}
	{% endfor %}
	{% if lane_sections is not empty %}
		{% set lanes = lanes|merge( [ {
			key: bucket.key,
			status: bucket.status,
			label: bucket.label,
			icon_class: bucket.icon_class,
			count: bucket.display_count,
			summary: bucket.summary_text,
			selection_json: bucket.selection.selection_json,
			bucket_selection: layer.bucket_selection,
			group_sections: lane_sections,
			is_open: true
		} ] ) %}
	{% endif %}
{% endfor %}

{# A passing check can show both as a group and as a summary row; list it once. #}
{% set passing_labels = passing|map( p => p.group.label|lower ) %}
{% set healthy_rows = healthy_rows|default( [] )|filter( r => r.title|lower not in passing_labels ) %}
{% set passing_count = passing|length + healthy_rows|length %}
{% set passing_names = ( passing|map( p => p.group.label ) )|merge( healthy_rows|map( r => r.title ) )|filter( n => n is not empty ) %}
{% set sections = lanes %}
{% if passing_count > 0 %}
	{% set sections = sections|merge( [ {
		key: 'passing',
		status: 'good',
		label: strings.passing_label|format( passing_count ),
		icon_class: 'bi bi-check-circle-fill',
		count: passing_count,
		summary: passing_names|length > 3
			? strings.passing_more|format( passing_names|slice( 0, 3 )|join( ', ' ), passing_names|length - 3 )
			: passing_names|join( ', ' ),
		selection_json: '',
		is_open: false
	} ] ) %}
{% endif %}
{% if not_covered is not empty %}
	{% set sections = sections|merge( [ {
		key: 'not_covered',
		status: 'pro',
		label: strings.not_covered_label,
		icon_class: 'bi bi-lock-fill',
		count: not_covered|length,
		summary: strings.not_covered_summary,
		selection_json: '',
		is_open: true
	} ] ) %}
{% endif %}

<div class="actions-queue-sections actions-queue-sections--{{ view }}"
	 data-actions-queue-sections="1"
	 data-view="{{ view }}"
	 data-set-view-action="{{ set_view_action_json|default('')|e('html_attr') }}">

	{% if sections|length > 0 %}
		<div class="actions-queue-sections__bar">
			<div class="actions-queue-sections__tabs" role="tablist">
				{% for section in sections %}
					<button type="button"
							class="actions-queue-sections__tab status-{{ section.status }}"
							role="tab"
							id="ActionsQueueTab-{{ section.key }}"
							aria-controls="ActionsQueueSection-{{ section.key }}"
							aria-selected="{{ loop.first ? 'true' : 'false' }}"
							data-actions-queue-tab="{{ section.key }}">
						<i class="{{ section.icon_class }}" aria-hidden="true"></i>{{ section.key == 'passing' ? strings.passing_tab : section.label }}
						<span class="actions-queue-sections__count">{{ section.count }}</span>
					</button>
				{% endfor %}
			</div>
			<div class="actions-queue-sections__view" role="group" aria-label="{{ strings.view_label|default('Layout') }}">
				<button type="button" class="actions-queue-sections__view-btn" data-actions-queue-view="sections"
						aria-pressed="{{ view == 'sections' ? 'true' : 'false' }}">
					<i class="bi bi-view-stacked" aria-hidden="true"></i>{{ strings.view_sections|default('Sections') }}
				</button>
				<button type="button" class="actions-queue-sections__view-btn" data-actions-queue-view="tabs"
						aria-pressed="{{ view == 'tabs' ? 'true' : 'false' }}">
					<i class="bi bi-segmented-nav" aria-hidden="true"></i>{{ strings.view_tabs|default('Tabs') }}
				</button>
			</div>
		</div>
	{% endif %}

	{% if lanes is empty %}
		<div class="actions-queue-sections__clear">
			<i class="bi bi-check-circle-fill" aria-hidden="true"></i>{{ strings.nothing_here }}
		</div>
	{% endif %}

	{% for section in sections %}
		<section class="actions-queue-section status-{{ section.status }}"
				 id="ActionsQueueSection-{{ section.key }}"
				 data-actions-queue-section-key="{{ section.key }}"
				 {% if section.selection_json is not empty %}data-actions-queue-bucket-selection="{{ section.selection_json }}"{% endif %}
				 data-tab-selected="{{ loop.first ? '1' : '0' }}"
				 aria-labelledby="ActionsQueueSectionHead-{{ section.key }}">
			<button type="button"
					class="actions-queue-section__head"
					id="ActionsQueueSectionHead-{{ section.key }}"
					data-actions-queue-section-toggle="1"
					aria-expanded="{{ section.is_open ? 'true' : 'false' }}"
					aria-controls="ActionsQueueSectionBody-{{ section.key }}">
				<span class="actions-queue-section__icon"><i class="{{ section.icon_class }}" aria-hidden="true"></i></span>
				<span class="actions-queue-section__label">{{ section.label }}</span>
				{% if section.summary is not empty %}
					<span class="actions-queue-section__summary">{{ section.summary }}</span>
				{% endif %}
				{% if section.key != 'passing' %}
					<span class="actions-queue-section__count">{{ section.count }}</span>
				{% endif %}
				<i class="bi bi-chevron-down actions-queue-section__chevron" aria-hidden="true"></i>
			</button>

			<div class="actions-queue-section__body"
				 id="ActionsQueueSectionBody-{{ section.key }}"
				 {% if not section.is_open and view != 'tabs' %}hidden{% endif %}>
				{% if section.key == 'passing' %}
					{% for entry in passing %}
						{% include '/wpadmin/components/actions_queue/landing_group_row.twig' with {
							group: entry.group,
							bucket_selection: entry.bucket_selection,
							strings: strings
						} only %}
					{% endfor %}
					{% for row in healthy_rows %}
						{% include '/wpadmin/components/actions_queue/landing_item_row.twig' with {
							row: row,
							is_passing: true
						} only %}
					{% endfor %}
				{% elseif section.key == 'not_covered' %}
					{% for entry in not_covered %}
						{% include '/wpadmin/components/actions_queue/landing_group_row.twig' with {
							group: entry.group,
							bucket_selection: entry.bucket_selection,
							strings: strings
						} only %}
					{% endfor %}
				{% else %}
					{% for group_section in section.group_sections %}
						{% if group_section.heading is not empty and section.group_sections|length > 1 %}
							<div class="actions-queue-section__subhead">{{ group_section.heading }}</div>
						{% endif %}
						{% for group in group_section.groups %}
							{% include '/wpadmin/components/actions_queue/landing_group_row.twig' with {
								group: group,
								bucket_selection: section.bucket_selection,
								strings: strings
							} only %}
						{% endfor %}
					{% endfor %}
				{% endif %}
			</div>
		</section>
	{% endfor %}
</div>
