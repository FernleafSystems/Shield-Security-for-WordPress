{#
	The one search results list, for Configure's search and the search dialog: the best match first and set
	apart, then the rest, under a heading for each kind of result where there are several kinds.
	Settings show where they live and their current value. Built by SearchResultsList.
#}
<div class="shield-search-results" data-search-results="1">
	{% if flags.has_results %}
		<div class="shield-search-results__list">
			{% for section in vars.sections %}
				{% if section.heading is not empty %}
					<h3 class="shield-search-results__heading">{{ section.heading }}</h3>
				{% endif %}
				{% for result in section.results %}
					{% set is_best = loop.parent.loop.first and loop.first %}
					{% if section.heading is empty and loop.index == 2 %}
						<div class="shield-search-results__heading">{{ strings.more_label }}</div>
					{% endif %}
					<a class="shield-search-results__item{{ is_best ? ' is-best' : '' }}{% for class in result.classes %} {{ class }}{% endfor %}"
					   href="{{ result.href }}"
					   {% if result.is_external %}target="_blank" rel="noopener"{% endif %}
					   {% for attr, value in result.attributes %} {{ attr }}="{{ value|e('html_attr') }}"{% endfor %}>
						<span class="shield-search-results__copy">
							{% if is_best %}
								<span class="shield-search-results__best">{{ strings.best_label }}</span>
							{% endif %}
							<span class="shield-search-results__name">
								<span class="shield-search-results__label" data-search-highlight="1">{{ result.label }}</span>
								{% if result.type_label is not empty %}
									<span class="shield-search-results__type">{{ result.type_label }}</span>
								{% endif %}
							</span>
							{% if result.path is not empty or result.summary is not empty %}
								<span class="shield-search-results__summary" data-search-highlight="1">
									{%- if result.path is not empty %}<span class="shield-search-results__path">{{ result.path }}</span>{% endif -%}
									{%- if result.path is not empty and result.summary is not empty %} · {% endif -%}
									{{- result.summary -}}
								</span>
							{% endif %}
						</span>
						{% if result.value is not empty %}
							<span class="shield-search-results__value">{{ result.value }}</span>
						{% elseif result.is_external %}
							<span class="shield-search-results__value"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></span>
						{% endif %}
					</a>
				{% endfor %}
			{% endfor %}
		</div>
		<div class="shield-search-results__foot">
			<span>{{ strings.count_label }}</span>
			<span class="shield-search-results__keys" aria-hidden="true">
				<kbd>Tab</kbd> {{ strings.move_label }} <kbd>Enter</kbd> {{ strings.open_label }}
			</span>
		</div>
	{% else %}
		<p class="shield-search-results__empty">{{ strings.no_results }}</p>
	{% endif %}
</div>
