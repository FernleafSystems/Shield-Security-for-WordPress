{#
	The search dialog's results, in the same list as Configure's search: the best match first and set apart,
	then each kind of result under its own heading. Settings show where they live and their current value.
#}
<div class="configure-search-results super-search-results" data-super-search-results="1">
	{% if flags.has_results %}
		<div class="configure-search-results__list">
			{% for section in vars.sections %}
				<h3 class="configure-search-results__heading">{{ section.heading }}</h3>
				{% for result in section.results %}
					{% set is_best = loop.parent.loop.first and loop.first %}
					<a class="configure-search-results__item{{ is_best ? ' is-best' : '' }} {{ result.classes|join(' ') }}"
					   href="{{ result.href }}"
					   {% if result.target is not empty %}target="{{ result.target }}" rel="noopener"{% endif %}
					   {% for data_key, data_value in result.data %}data-{{ data_key }}="{{ data_value|e('html_attr') }}" {% endfor %}>
						<span class="configure-search-results__icon">
							<i class="{{ result.icon_class }}" aria-hidden="true"></i>
						</span>
						<span class="configure-search-results__copy">
							{% if is_best %}
								<span class="configure-search-results__best">{{ strings.best_label }}</span>
							{% endif %}
							<span class="configure-search-results__name">
								<span class="configure-search-results__label" data-configure-search-highlight="1">{{ result.label }}</span>
								{% if result.type is not empty %}
									<span class="configure-search-results__type configure-search-results__type--{{ result.type_key }}">{{ result.type }}</span>
								{% endif %}
							</span>
							{% if result.path is not empty or result.summary is not empty %}
								<span class="configure-search-results__summary" data-configure-search-highlight="1">
									{%- if result.path is not empty %}<span class="configure-search-results__path">{{ result.path }}</span>{% endif -%}
									{%- if result.path is not empty and result.summary is not empty %} · {% endif -%}
									{{- result.summary -}}
								</span>
							{% endif %}
						</span>
						{% if result.value is not empty %}
							<span class="configure-search-results__value">{{ result.value }}</span>
						{% elseif result.target is not empty %}
							<span class="configure-search-results__value"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></span>
						{% endif %}
					</a>
				{% endfor %}
			{% endfor %}
		</div>
		<div class="configure-search-results__foot">
			<span>{{ strings.count_label }}</span>
			<span class="configure-search-results__keys" aria-hidden="true">
				<kbd>Tab</kbd> {{ strings.move_label }} <kbd>Enter</kbd> {{ strings.open_label }}
			</span>
		</div>
	{% else %}
		<p class="configure-search-results__empty mb-0">{{ strings.no_results }}</p>
	{% endif %}
</div>
