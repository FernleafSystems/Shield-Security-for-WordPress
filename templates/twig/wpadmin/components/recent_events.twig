<div id="SectionRecentEvents" class="card w-100">
	<div class="card-header">
		<h2 class="card-title h5">{{ strings.title_recent }}</h2>
		<p class="card-subtitle h6 text-muted">{{ strings.box_receve_subtitle }}</p>
	</div>
	<div class="card-body overflow_container">
		<div class="overflow_inner">
			{% for insight_event in vars.insight_events %}
				<dl class="row">
					<dt class="col-6">{{ insight_event.name }}:</dt>
					<dd class="col-6">{{ insight_event.val }}</dd>
				</dl>
			{% endfor %}
		</div>
	</div>
</div>
