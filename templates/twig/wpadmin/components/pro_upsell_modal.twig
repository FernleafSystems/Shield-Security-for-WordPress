<div class="modal-body pro-upsell__body">
	<aside class="pro-upsell__left-panel">
		<img class="pro-upsell__logo" src="{{ upsell.logo_url }}" alt="">
		<div class="pro-upsell__left-copy">
			{% for line in upsell.left_lines %}
				<p>{{ line.text }}{% if line.emphasis != '' %}<span class="pro-upsell__emphasis">{{ line.emphasis }}</span>{% endif %}</p>
			{% endfor %}
		</div>
	</aside>
	<section class="pro-upsell__comparison">
		<div class="modal-header pro-upsell__header">
			<h2 class="modal-title" id="{{ upsell.title_id }}">{{ upsell.heading }}</h2>
			<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ upsell.labels.close }}"></button>
		</div>
		<table class="table pro-upsell__table">
			<thead>
				<tr><th scope="col"><span class="visually-hidden">{{ upsell.labels.protection }}</span></th><th scope="col">{{ upsell.labels.free }}</th><th scope="col">{{ upsell.labels.pro }}</th></tr>
			</thead>
			<tbody>
				{% for row in upsell.rows %}
					<tr>
						<th scope="row">{{ row.label }}</th>
						<td class="pro-upsell__state pro-upsell__state--free"><span aria-hidden="true">{% if row.free %}✓{% else %}—{% endif %}</span><span class="visually-hidden">{% if row.free %}{{ upsell.labels.included }}{% else %}{{ upsell.labels.not_included }}{% endif %}</span></td>
						<td class="pro-upsell__state pro-upsell__state--pro"><span aria-hidden="true">{% if row.pro %}✓{% else %}—{% endif %}</span><span class="visually-hidden">{% if row.pro %}{{ upsell.labels.included }}{% else %}{{ upsell.labels.not_included }}{% endif %}</span></td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
		<div class="pro-upsell__actions">
			<a class="btn pro-upsell__button" href="{{ upsell.hrefs.go_pro }}" target="_blank" rel="noopener noreferrer">{{ upsell.labels.view_pro_plans }}</a>
			<a class="pro-upsell__compare-link" href="{{ upsell.hrefs.compare_features }}" target="_blank" rel="noopener noreferrer">{{ upsell.labels.compare_features }} <span aria-hidden="true">→</span></a>
		</div>
	</section>
</div>
