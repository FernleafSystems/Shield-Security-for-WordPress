{% extends '/wpadmin/plugin_pages/base_inner_page.twig' %}

{% block inner_page_body %}
	{% import '/components/security_admin/pin_form.twig' as pin %}
	{# The same PIN dialog that WP admin pages open from their Unlock links, shown in place over the restricted page. #}
	<div id="SecurityAdminOverlay" class="security-admin-overlay"
		 role="dialog" tabindex="-1"
		 aria-labelledby="SecurityAdminLabel"
		 aria-describedby="SecurityAdminDescription">
		<div class="shield-accessible-dialog__surface">
			<div class="shield-accessible-dialog__header operator-tile-card__main">
				<span class="shield-accessible-dialog__icon operator-tile-card__icon" aria-hidden="true">
					<i class="{{ pin.icon_class() }}"></i>
				</span>
				<div class="operator-tile-card__copy">
					<h2 id="SecurityAdminLabel" class="shield-accessible-dialog__title">{{ strings.aar_login_title }}</h2>
					<div id="SecurityAdminDescription" class="shield-accessible-dialog__message">{{ strings.aar_login_message }}</div>
				</div>
			</div>
			<div class="shield-accessible-dialog__content">
				{{ pin.form( strings, hrefs, false ) }}
				{# A PIN can be typed and Enter pressed before Shield's script is listening. That Enter is remembered
				   here, so the PIN is sent as soon as it can be, without being asked for twice. #}
				<script>
					document.getElementById( 'ShieldSecAdminUnlockPin' ).addEventListener( 'keydown', function ( evt ) {
						if ( evt.key === 'Enter' ) {
							this.form.dataset.shieldSubmitAsked = '1';
						}
					} );
				</script>
			</div>

			{% if flags.allow_email_override %}
				<hr class="my-3">
				<div class="text-center">
					<button type="button" id="SecAdminRemoveConfirmEmail" class="small fw-semibold shield-button-link">
						{{ strings.disable_security_admin }}
					</button>
					<p class="text-muted small mt-1 mb-0">
						{{ strings.send_to_email }}
					</p>
				</div>
			{% endif %}
		</div>
	</div>
{% endblock %}
