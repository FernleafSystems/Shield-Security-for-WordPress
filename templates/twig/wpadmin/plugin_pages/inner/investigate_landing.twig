{% extends '/wpadmin/plugin_pages/base_inner_page.twig' %}

{#
	Investigate is one place with tabs. The lookup stays above whatever subject it opens; the logs and IP
	rules sit in their own tabs, each table starting the first time its tab opens; Live traffic opens the
	live subject in the same place as the lookup's subjects.
#}
{% block inner_page_body %}
	{% set current_tab = vars.investigate_current_tab %}
	{% set shows_subjects = current_tab in [ 'lookup', 'live' ] %}
	<div class="investigate-landing"
		 data-investigate-landing="1"
		 data-investigate-current-tab="{{ current_tab }}"
		 data-investigate-panel-loading="{{ strings.panel_loading }}"
		 data-investigate-panel-error="{{ strings.panel_load_error }}">
		{% include '/wpadmin/components/investigate/tabs.twig' with { tabs: vars.investigate_tabs } only %}

		<div class="investigate-landing__tabpanel" data-investigate-tabpanel="lookup" {% if current_tab != 'lookup' %}hidden{% endif %}>
			{{ vars.investigate_lookup|raw }}
		</div>

		<div class="investigate-landing__drilldown" data-investigate-section="drilldown" {% if not shows_subjects %}hidden{% endif %}>
			{% include '/wpadmin/components/page/drill_down_shell.twig' with {
				shell: vars.drill_shell
			} only %}
		</div>

		{% for log in vars.investigate_logs %}
			<div class="investigate-landing__tabpanel investigate-landing__log"
				 data-investigate-tabpanel="{{ log.key }}"
				 {% if current_tab != log.key %}hidden{% endif %}>
				<div class="shield-section-datatable">
					<table id="{{ log.table_id }}" class="table table-striped table-bordered" style="width: 100%;"></table>
				</div>
			</div>
		{% endfor %}
	</div>
{% endblock %}
