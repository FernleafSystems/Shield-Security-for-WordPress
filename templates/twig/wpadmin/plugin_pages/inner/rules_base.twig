{% extends '/wpadmin/plugin_pages/base_inner_page.twig' %}

{% block inner_page_body %}
	{% if flags.can_custom_rules %}
		{% block inner_page_body_custom_rules %}{% endblock %}
	{% else %}
		<div class="row">
			<div class="col">
				{% include '/wpadmin/components/feature_unavailable.twig' with { feature: vars.upgrade_feature } %}
			</div>
		</div>

		<div class="row">
			<div class="col mt-4 mb-2">
				<h6 class="text-center">
					{% import '/common/macros.twig' as icwp_macros %}
					<button type="button"
							class="btn btn-primary option-video"
							data-vimeoid="908715157">
						{{ icwp_macros.icon(imgs.svgs.video) }}
						{{ strings.what_is_custom_security_rules_feature }}</button>
				</h6>
			</div>
		</div>
	{% endif %}
{% endblock %}
