<div class="operator-mode-landing">
	<div class="operator-mode-landing__overview" data-shield-status="{{ vars.dashboard_strip.overall.status }}">
		<section class="operator-mode-overview__status shield-card"
				 data-shield-tour="dashboard-actions"
		         aria-label="{{ vars.dashboard_strip.overall.accessible_label }}">
			<div class="shield-card-accent status-{{ vars.dashboard_strip.overall.status }}"></div>
			<div class="operator-mode-overview__overall">
				<span class="operator-mode-overview__overall-icon status-{{ vars.dashboard_strip.overall.status }}" aria-hidden="true">
					<i class="{{ vars.dashboard_strip.overall.icon_class }}"></i>
				</span>
				<div class="operator-mode-overview__overall-copy">
					<h2 class="operator-mode-overview__overall-title">{{ vars.dashboard_strip.overall.title }}</h2>
					<p class="operator-mode-overview__overall-summary">{{ vars.dashboard_strip.overall.summary }}</p>
				</div>
			</div>

			<div class="operator-mode-overview__summaries" data-shield-tour="dashboard-queue">
				{% for summary in vars.dashboard_strip.summaries %}
					<a href="{{ summary.href }}"
					   class="operator-mode-overview__summary status-{{ summary.status }}"
					   data-summary-id="{{ summary.id|e('html_attr') }}"
					   aria-label="{{ summary.accessible_label }}">
						<span class="operator-mode-overview__summary-count">{{ summary.count }}</span>
						<span class="operator-mode-overview__summary-copy">
							<span class="operator-mode-overview__summary-label">{{ summary.label }}</span>
							<span class="operator-mode-overview__summary-text">{{ summary.summary }}</span>
						</span>
						<i class="bi bi-arrow-right" aria-hidden="true"></i>
					</a>
				{% endfor %}
			</div>
		</section>

		<div class="operator-mode-overview__destinations">
			{% for card in vars.destination_cards %}
				<a href="{{ card.href }}"
				   class="operator-mode-overview__destination shield-card"
				   data-mode="{{ card.mode|e('html_attr') }}"
				   data-shield-tour="dashboard-{{ card.mode|e('html_attr') }}"
				   aria-label="{{ card.accessible_label }}">
					<div class="shield-card-accent accent-{{ card.accent }}"></div>
					<span class="operator-mode-overview__destination-icon accent-{{ card.accent }}" aria-hidden="true">
						<i class="{{ card.icon_class }}"></i>
					</span>
					<span class="operator-mode-overview__destination-copy">
						<span class="operator-mode-overview__destination-title">{{ card.title }}</span>
						<span class="operator-mode-overview__destination-description">{{ card.description }}</span>
						<span class="operator-mode-overview__destination-cta">
							{{ card.cta }}
							<i class="bi bi-arrow-right" aria-hidden="true"></i>
						</span>
					</span>
				</a>
			{% endfor %}
		</div>
	</div>

	<div class="operator-mode-landing__live-monitor-placement">
		{% include '/wpadmin/components/dashboard/live_monitor.twig' with {
			vars: vars.live_monitor
		} only %}
	</div>
</div>
