{% extends '/email/base_email.twig' %}

{% block email_body %}

	{% block email_intro %}
		<p>{{ body.strings.url_site }}: {{ body.hrefs.url_site }}</p>
		{% for p in body.strings.intro %}
			<p>{{ p }}</p>
		{% endfor %}
	{% endblock %}

	{% block alerted_changes %}

		{% for alert_type,alert_group_data in body.vars.alert_groups %}

			{% if alert_group_data.items|length > 0 %}
				<h5 style="margin-bottom: 5px;">{{ alert_group_data.title }}</h5>
				<div style="margin:6px 0;padding:20px;border:1px dashed gray;display:inline-block;background-color: #ff000005;">
					<ul style="margin:5px 0 0 0;padding:0;">
						{% for item in alert_group_data.items %}
							<li>
								{% for line in item.lines %}
									{% if line.label|length > 0 %}<strong>{{ line.label }}</strong>: {% endif %}
									{% if line.style == 'code' %}<code>{{ line.value }}</code>{% else %}{{ line.value }}{% endif %}{% if not loop.last %}<br/>{% endif %}
								{% endfor %}
								{% if item.href|length > 0 %}
									<br/>
									<a href="{{ item.href|e('html_attr') }}" target="_blank" rel="noopener noreferrer" style="display:inline-block;margin-top:6px;color:#008000;text-decoration:underline;">{{ item.cta_label }}</a>
								{% endif %}
							</li>
						{% endfor %}
					</ul>
				</div>
			{% endif %}

		{% endfor %}

	{% endblock %}

	{% block email_outro %}
		{% for p in body.strings.outro %}
			<p>{{ p }}</p>
		{% endfor %}
	{% endblock %}

{% endblock %}
