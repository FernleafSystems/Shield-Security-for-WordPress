{% extends '/email/base_email.twig' %}

{% block email_body %}
	<h2 style="margin: 0 0 12px; font-size: 18px; line-height: 1.3; color: #333333;">{{ body.strings.heading }}</h2>

	<p style="margin: 0 0 16px;">{{ body.strings.intro }}</p>

	<p style="margin: 0 0 16px;">
		<a href="{{ body.hrefs.verify }}"
		   style="display: inline-block; padding: 12px 20px; border-radius: 4px; background-color: #008000; color: #ffffff; font-weight: bold; text-decoration: none;">{{ body.strings.verify }} &rarr;</a>
	</p>

	<p style="margin: 0 0 16px;">
		{{ body.strings.or_copy }}
		<br /><code style="word-break: break-all; font-size: 12px;">{{ body.hrefs.verify }}</code>
	</p>

	<ul style="margin: 0 0 16px; padding-left: 20px;">
		<li>{{ body.strings.logged_in }}</li>
		<li>{{ body.strings.expiry }}</li>
	</ul>

	<p style="margin: 0 0 8px; color: #777777;">{{ body.strings.unexpected }}</p>
{% endblock %}
