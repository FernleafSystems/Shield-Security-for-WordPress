{% extends '/components/merlin/steps/base.twig' %}

{% block slide_body_video_section_blurb %}
	<p>{{ strings.report_email_text }}</p>
{% endblock %}

{% block slide_body_action_area %}
	{% import '/common/macros.twig' as icwp_macros %}

	<form class="form-horizontal merlin-form ajax-form">
		{{ icwp_macros.formInput_Hidden( 'step_slug', vars.step_slug ) }}
		<div class="row">
			<div class="col">
				<label class="form-label" for="ReportEmail-{{ vars.step_slug }}">{{ strings.report_email_label }}</label>
				<input type="email"
					   class="form-control"
					   id="ReportEmail-{{ vars.step_slug }}"
					   name="ReportEmail"
					   autocomplete="email"
					   value="{{ vars.report_email }}"
					   placeholder="{{ vars.admin_email }}">
				{{ icwp_macros.formInput_Submit2( strings.report_email_button, null, 'secondary', false, 'mt-2' ) }}
			</div>
		</div>
	</form>
{% endblock %}
