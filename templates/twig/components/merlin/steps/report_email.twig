{% extends '/components/merlin/steps/base.twig' %}

{% block slide_body_video_section_blurb %}
	<p>{{ strings.report_email_text }}</p>
	{% if strings.hold_notice is not empty %}
		<p>{{ strings.hold_notice }}</p>
	{% endif %}
{% endblock %}

{% block slide_body_action_area %}
	{% import '/common/macros.twig' as icwp_macros %}

	<form class="form-horizontal merlin-form ajax-form">
		{{ icwp_macros.formInput_Hidden( 'step_slug', vars.step_slug ) }}
		<div class="row">
			<div class="col">
				<label class="form-label" for="ReportEmail-{{ vars.step_slug }}">{{ strings.report_email_label }}</label>
				{# The placeholder is plainly an example: a real address there would look like one already filled in. #}
				<input type="email"
					   class="form-control"
					   id="ReportEmail-{{ vars.step_slug }}"
					   name="ReportEmail"
					   autocomplete="email"
					   required
					   data-report-email-input="1"
					   value="{{ vars.report_email }}"
					   placeholder="{{ strings.report_email_placeholder }}">
				<small class="form-text" data-report-email-invalid="1" role="status" hidden>{{ strings.report_email_invalid }}</small>
				{# Saving waits for an address that can be saved. The second button belongs to the form below, so the
				   two choices sit side by side. #}
				<div class="merlin-report-email-actions">
					<button type="submit" class="btn btn-secondary" data-report-email-save="1"
							{% if vars.report_email is empty %}disabled{% endif %}>{{ strings.report_email_button }}</button>
					<button type="submit" class="btn btn-link" form="ReportEmailUseAdmin-{{ vars.step_slug }}">{{ strings.use_admin_button }}</button>
				</div>
			</div>
		</div>
	</form>

	<form class="merlin-form ajax-form" id="ReportEmailUseAdmin-{{ vars.step_slug }}" hidden>
		{{ icwp_macros.formInput_Hidden( 'step_slug', vars.step_slug ) }}
		{{ icwp_macros.formInput_Hidden( 'use_site_admin_email', 'Y' ) }}
	</form>
{% endblock %}
