{% extends '/components/merlin/steps/base.twig' %}

{% block slide_body_video_section_blurb %}
	{% import '/common/macros.twig' as icwp_macros %}

	<p>{{ strings.integrations_text }}</p>
	<p>{{ strings.custom_built|e|format( icwp_macros.silentcaptcha() )|raw }}</p>
	<p>{{ strings.form_types_intro }}</p>
	<ul style="list-style: square">
		{% for form_type in strings.form_types %}
			<li>{{ form_type }}</li>
		{% endfor %}
	</ul>
	<p>{{ strings.integrations_text2 }}</p>

{% endblock slide_body_video_section_blurb %}

{% block slide_body_action_area %}
	{% import '/common/macros.twig' as icwp_macros %}

	<form class="form-horizontal merlin-form ajax-form">
		{{ icwp_macros.formInput_Hidden( 'step_slug', vars.step_slug ) }}

		<div class="row">
			<div class="col mb-2">
				<h6 class="pb-1 border-bottom d-inline-block">{{ strings.select_heading }}</h6>
			</div>
		</div>

		{% for integration in vars.integrations %}
			{# An integration the plan doesn't cover can't be ticked, and says where to find out more. #}
			{% set integration_help %}
				{% if integration.has_cap %}
					{{ strings.help_available|e|format( icwp_macros.silentcaptcha() )|raw }}
					[<a href="https://silentcaptcha.com/" target="_blank" rel="noopener noreferrer">{{ strings.more_info_label }}</a>]
				{% else %}
					{{ strings.help_unavailable }}
					[<a href="{{ hrefs.go_pro }}" target="_blank" rel="noopener noreferrer">{{ strings.more_info_label }}</a>]
				{% endif %}
			{% endset %}
			{{ icwp_macros.formInput_Checkbox(
				integration.slug,
				integration.name,
				strings.switch_on|format( integration.name ),
				integration_help,
				true, 'me-0', integration.has_cap
			) }}
		{% endfor %}

		{{ icwp_macros.formInput_Submit( strings.enable_button ) }}
	</form>
{% endblock %}
