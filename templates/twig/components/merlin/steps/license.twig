{% extends '/components/merlin/steps/base.twig' %}

{% block slide_body_video_section_blurb %}
	<p>{{ strings.license_check_text }}</p>
	{% set skip_button %}<button type="button" class="skip-step shield-button-link text-primary text-decoration-underline">{{ strings.license_skip_button }}</button>{% endset %}
	<p>{{ strings.license_skip_text|e|format( skip_button )|raw }}</p>
{% endblock %}

{% block slide_body_action_area %}
	{% import '/common/macros.twig' as icwp_macros %}

	<form class="form-horizontal merlin-form ajax-form">
		{{ icwp_macros.formInput_Hidden( 'step_slug', vars.step_slug ) }}

		<div class="row">
			<div class="col">
				<button type="submit" class="btn btn-primary py-2 px-4">
					{{ strings.check_license_button }}
				</button>
			</div>
		</div>

	</form>
{% endblock %}
