{% extends '/components/merlin/steps/base.twig' %}

{% block slide_body_video_section_blurb %}
	{% import '/common/macros.twig' as icwp_macros %}
	<p>{{ strings.intro }}</p>
	<form class="merlin-form ajax-form" autocomplete="off">
		{{ icwp_macros.formInput_Hidden( 'step_slug', vars.step_slug ) }}

		<div class="row mb-3">
			<label for="inputEmail" class="col-sm-4 col-form-label">{{ strings.email_label }}</label>
	    <div class="col-sm-8">
	      <input type="email" class="form-control"
	             name="email" value="{{ vars.email }}" id="inputEmail"
	             placeholder="{{ strings.email_placeholder }}" aria-label="{{ strings.email_placeholder }}" />
	    </div>
		</div>
		<div class="row mb-4">
			<label for="inputFirstName" class="col-sm-4 col-form-label">{{ strings.name_label }}</label>
	    <div class="col-sm-4">
		    <input type="text" class="form-control"
		           name="first_name" value="{{ vars.first_name }}" id="inputFirstName"
		           placeholder="{{ strings.first_name }}" aria-label="{{ strings.first_name }}" />
	    </div>
	    <div class="col-sm-4">
		    <input type="text" class="form-control"
		           name="last_name" value="{{ vars.last_name }}"
		           placeholder="{{ strings.last_name }}" aria-label="{{ strings.last_name }}" />
	    </div>
		</div>

		{% set gdpr_help %}{{ strings.gdpr_help }} <a href="https://getshieldsecurity.com/policies/privacy-policy/" target="_blank" rel="noopener noreferrer">{{ strings.privacy_policy }}</a>{% endset %}
		{{ icwp_macros.formInput_Checkbox( 'gdpr_agree', strings.gdpr_title, strings.gdpr_agree, gdpr_help ) }}

		{{ icwp_macros.formInput_Submit( strings.newsletter_button, 'mt-2' ) }}
	</form>

	{% set signup_link %}<a href="{{ hrefs.email }}" target="_blank" rel="noopener noreferrer">{{ strings.signup_fallback_link }}</a>{% endset %}
	<p class="mt-4">{{ strings.signup_fallback|e|format( signup_link )|raw }}</p>
{% endblock %}
