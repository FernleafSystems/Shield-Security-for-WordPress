{#
	The search dialog: the shared search box floating over the page, and the shared results list under it.
	Before anything is typed, it says what can be searched.
#}
<div class="modal fade shield-search-modal"
	 id="ModalSuperSearchBox"
	 tabindex="-1"
	 aria-labelledby="ModalSuperSearchTitle"
	 aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content shield-search" data-super-search="1" data-search-state="idle">
			<h2 id="ModalSuperSearchTitle" class="visually-hidden">{{ strings.search_shield }}</h2>
			<div class="shield-search-box">
				<i class="bi bi-search" aria-hidden="true"></i>
				<label for="ModalSuperSearchInput" class="visually-hidden">{{ strings.search_shield }}</label>
				<input type="search"
					   id="ModalSuperSearchInput"
					   class="shield-search-box__input"
					   autocomplete="off"
					   spellcheck="false"
					   aria-describedby="ModalSuperSearchHint"
					   placeholder="{{ strings.search_modal_placeholder }}"
					   {% if not flags.is_security_admin %}disabled="disabled"{% endif %}>
				<button type="button" class="shield-search-box__close" data-bs-dismiss="modal"
						aria-label="{{ strings.close|e('html_attr') }}"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
			</div>
			<div class="shield-search-results shield-search__hints" data-super-search-hints="1">
				<p class="shield-search-results__heading" id="ModalSuperSearchHint">{{ strings.search_modal_min_chars }}</p>
				<ul class="shield-search-results__hints" aria-label="{{ strings.search_modal_you_could|e('html_attr') }}">
					{% for suggestion in strings.search_suggestions %}
						<li><i class="bi bi-check2" aria-hidden="true"></i> {{ suggestion }}</li>
					{% endfor %}
				</ul>
			</div>
			<div class="shield-search__results" data-super-search-body="1" aria-live="polite" aria-busy="false"></div>
		</div>
	</div>
</div>
