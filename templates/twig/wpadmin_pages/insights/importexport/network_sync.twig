<section id="{{ network_sync.section_id }}"
		 class="import-export-network-sync"
		 data-import-export-network-sync="1"
		 data-import-export-sync-state="{{ network_sync.sync_state }}">
	<div class="import-export-sync-topbar{% if network_sync.is_enabled %} is-enabled{% endif %}">
		<div class="import-export-sync-topbar__state">
			<span class="import-export-sync-topbar__dot" aria-hidden="true"></span>
			<div class="import-export-sync-topbar__copy">
				<h5>{{ network_sync.status.title }}</h5>
				<p>{{ network_sync.status.summary }}</p>
			</div>
		</div>

		<div class="form-check form-switch import-export-sync-toggle">
			<input class="form-check-input"
				   type="checkbox"
				   role="switch"
				   id="{{ network_sync.toggle.id }}"
				   data-import-export-sync-toggle="1"
				   {% if network_sync.toggle.is_checked %}checked{% endif %}>
			<label class="form-check-label" for="{{ network_sync.toggle.id }}">
				{{ network_sync.toggle.label }}
			</label>
		</div>
	</div>

	{% if network_sync.is_disabled %}
		<div class="import-export-network-disabled" data-import-export-network-disabled="1">
			<i class="bi bi-toggle-off" aria-hidden="true"></i>
			<div>
				<h5>{{ network_sync.disabled.title }}</h5>
				<p>{{ network_sync.disabled.summary }}</p>
			</div>
		</div>
	{% elseif network_sync.is_enabled %}
		<div class="import-export-workbench" data-import-export-workbench="1">
			<div class="import-export-rail">
				<div class="import-export-rail__status">
					<span class="import-export-rail__eyebrow">{{ network_sync.rail.connection_label }}</span>
					<strong>{{ network_sync.rail.client_count_label }}</strong>
				</div>

				<div class="import-export-task-list" role="tablist" aria-orientation="vertical">
					{% for task in network_sync.tasks %}
						<button type="button"
								class="import-export-task{% if task.is_active %} active{% endif %}"
								data-import-export-task="{{ task.key }}"
								role="tab"
								aria-selected="{{ task.is_active ? 'true' : 'false' }}">
							<i class="{{ task.icon_class }}" aria-hidden="true"></i>
							<span>
								<strong>{{ task.title }}</strong>
								<small>{{ task.summary }}</small>
							</span>
						</button>
					{% endfor %}
				</div>
			</div>

			<div class="import-export-detail">
				<div class="import-export-pane active"
					 data-import-export-pane="connect"
					 role="tabpanel">
					<header class="import-export-pane__header">
						<div>
							<h5>{{ network_sync.connect.title }}</h5>
							{% if not network_sync.connect.is_connected %}
								<p>{{ network_sync.connect.summary }}</p>
							{% endif %}
						</div>
						{% if network_sync.connect.is_connected %}
							<button type="button"
									class="btn btn-outline-warning btn-sm import-export-warning-action"
									data-import-export-disconnect="1">
								<i class="bi bi-x-lg" aria-hidden="true"></i>
								<span>{{ network_sync.connect.disconnect.label }}</span>
							</button>
						{% endif %}
					</header>

					{% if network_sync.connect.is_connected %}
						<div class="import-export-network-state is-connected" data-import-export-connected-master="1">
							<div class="import-export-network-state__graphic"
								 role="img"
								 aria-label="{{ network_sync.connect.connected.graphic_label }}">
								<span class="import-export-network-state__node" aria-hidden="true"></span>
								<span class="import-export-network-state__line" aria-hidden="true"></span>
								<span class="import-export-network-state__node is-master" aria-hidden="true"></span>
							</div>
							<div class="import-export-network-state__copy">
								<span>{{ network_sync.connect.connected.label }}</span>
								<strong>{{ network_sync.connect.connected.master_host }}</strong>
								<button type="button"
										id="{{ network_sync.connect.sync_now.id }}"
										class="btn btn-primary btn-sm import-export-primary-action"
										data-import-export-sync-now="1">
									<i class="{{ network_sync.connect.sync_now.icon_class }}" aria-hidden="true"></i>
									<span>{{ network_sync.connect.sync_now.label }}</span>
								</button>
							</div>
						</div>
					{% else %}
						<div class="import-export-network-state is-standalone" data-import-export-standalone-site="1">
							<div class="import-export-network-state__graphic"
								 role="img"
								 aria-label="{{ network_sync.connect.standalone.graphic_label }}">
								<span class="import-export-network-state__node is-standalone" aria-hidden="true"></span>
							</div>
							<div class="import-export-network-state__copy">
								<span>{{ network_sync.connect.standalone.label }}</span>
								<strong>{{ network_sync.connect.standalone.title }}</strong>
								<small>{{ network_sync.connect.standalone.summary }}</small>
							</div>
							<button type="button"
									id="{{ network_sync.connect.form.reveal_id }}"
									class="btn btn-primary import-export-primary-action"
									data-import-export-connect-reveal="1"
									aria-controls="{{ network_sync.connect.form.panel_id }}"
									aria-expanded="false">
								<i class="bi bi-link-45deg" aria-hidden="true"></i>
								<span>{{ network_sync.connect.standalone.action_label }}</span>
							</button>
						</div>
						<div id="{{ network_sync.connect.form.panel_id }}"
							 class="import-export-connect-form-panel"
							 data-import-export-connect-form-panel="1"
							 hidden>
							<form id="{{ network_sync.connect.form.id }}" class="import-export-connect-form" autocomplete="off">
								<div class="mb-3">
									<label class="form-label" for="{{ network_sync.connect.form.master_site_url_id }}">
										{{ network_sync.connect.form.master_site_url_label }}
									</label>
									<input class="form-control"
										   id="{{ network_sync.connect.form.master_site_url_id }}"
										   name="{{ network_sync.connect.form.master_site_url_name }}"
										   type="url"
										   placeholder="{{ network_sync.connect.form.master_site_url_placeholder }}"
										   value="{{ network_sync.connect.form.master_site_url_value }}">
								</div>

								<fieldset class="import-export-choice-group">
									<legend>{{ network_sync.connect.form.import_mode_label }}</legend>
									<div class="import-export-choice-group__options">
										{% for option in network_sync.connect.form.import_mode_options %}
											<label class="import-export-choice" for="{{ option.id }}">
												<input class="form-check-input"
													   type="radio"
													   id="{{ option.id }}"
													   name="ShieldNetwork"
													   value="{{ option.value }}"
													   data-import-export-link-choice="1"
													   data-action-label="{{ option.action_label }}"
													   {% if option.is_checked %}checked{% endif %}>
												<span>
													<strong>{{ option.label }}</strong>
													<small>{{ option.summary }}</small>
												</span>
											</label>
										{% endfor %}
									</div>
								</fieldset>

								<fieldset class="import-export-choice-group" data-import-export-verification-box="1">
									<legend>{{ network_sync.connect.form.verification_label }}</legend>
									<div class="import-export-choice-group__options">
										{% for option in network_sync.connect.form.verification_options %}
											<label class="import-export-choice" for="{{ option.id }}">
												<input class="form-check-input"
													   type="radio"
													   id="{{ option.id }}"
													   name="MasterSiteVerification"
													   value="{{ option.value }}"
													   data-import-export-auth-choice="{{ option.value }}"
													   {% if option.is_checked %}checked{% endif %}>
												<span>
													<strong>{{ option.label }}</strong>
													<small>{{ option.summary }}</small>
												</span>
											</label>
										{% endfor %}
									</div>
									<div class="import-export-secret-field d-none" data-import-export-secret-field="1">
										<label class="form-label" for="{{ network_sync.connect.form.secret_key_id }}">
											{{ network_sync.connect.form.secret_key_label }}
										</label>
										<input class="form-control"
											   id="{{ network_sync.connect.form.secret_key_id }}"
											   name="{{ network_sync.connect.form.secret_key_name }}"
											   type="text"
											   placeholder="{{ network_sync.connect.form.secret_key_placeholder }}"
											   disabled>
									</div>
								</fieldset>

								<div class="import-export-connect-form__footer">
									<div class="form-check import-export-confirm-check">
										<input type="checkbox"
											   class="form-check-input"
											   name="{{ network_sync.connect.form.confirm_name }}"
											   id="{{ network_sync.connect.form.confirm_id }}"
											   value="{{ network_sync.connect.form.confirm_value }}" />
										<label for="{{ network_sync.connect.form.confirm_id }}" class="form-check-label">
											{{ network_sync.connect.form.confirm_label }}
										</label>
										<div class="form-text">{{ network_sync.connect.form.confirm_help }}</div>
									</div>

									<button type="submit"
											class="btn btn-primary import-export-primary-action"
											data-import-export-primary-action="1">
										<i class="{{ network_sync.connect.form.submit_icon_class }}" aria-hidden="true"></i>
										<span>{{ network_sync.connect.form.submit_label_once }}</span>
									</button>
								</div>
							</form>
						</div>
					{% endif %}
				</div>

				<div class="import-export-pane"
					 data-import-export-pane="clients"
					 role="tabpanel"
					 hidden>
					<header class="import-export-pane__header">
						<div>
							<h5>{{ network_sync.clients.title }}</h5>
							<p>{{ network_sync.clients.summary }}</p>
						</div>
						<button type="button"
								class="btn btn-primary btn-sm"
								data-import-export-add-clients="1">
							<i class="bi bi-plus-lg" aria-hidden="true"></i>
							<span>{{ network_sync.clients.add_label }}</span>
						</button>
					</header>

					{% if network_sync.clients.has_connected_sites %}
						<table id="{{ network_sync.clients.table_id }}" class="table table-striped table-bordered import-export-sites-table"></table>
					{% else %}
						<p class="import-export-empty-state">{{ network_sync.clients.empty_message }}</p>
					{% endif %}
				</div>

				<div class="import-export-pane"
					 data-import-export-pane="profile"
					 role="tabpanel"
					 hidden>
					<header class="import-export-pane__header">
						<div>
							<h5>{{ network_sync.profile.title }}</h5>
							<p>{{ network_sync.profile.summary }}</p>
						</div>
						<button type="button"
								id="{{ network_sync.profile.copy_from_master.id }}"
								class="btn btn-outline-primary btn-sm"
								data-import-export-profile-copy-from-master="1"
								data-confirm-message="{{ network_sync.profile.copy_from_master.confirm_message }}"
								data-confirm-label="{{ network_sync.profile.copy_from_master.confirm_label }}">
							<i class="{{ network_sync.profile.copy_from_master.icon_class }}" aria-hidden="true"></i>
							<span>{{ network_sync.profile.copy_from_master.label }}</span>
						</button>
					</header>

					{{ network_sync.profile.form_html|raw }}
				</div>
			</div>
		</div>
	{% endif %}
</section>
