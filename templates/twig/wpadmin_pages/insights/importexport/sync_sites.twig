<section class="import-export-sync-sites" data-import-export-sync-sites="1">
	<div class="import-export-section-intro">
		<div>
			<h5>{{ sync_sites.title }}</h5>
			<p>{{ sync_sites.summary }}</p>
		</div>
		<div class="import-export-count-pill">
			<i class="bi bi-hdd-network" aria-hidden="true"></i>
			<span>{{ sync_sites.authorised_url_count_label }}</span>
		</div>
	</div>

	{% if sync_sites.is_disabled %}
		{% include '/wpadmin_pages/insights/scans/results/disabled_pane.twig' with sync_sites.disabled_pane only %}
	{% elseif sync_sites.is_enabled %}
		<div class="import-export-sync-sites__ready">
			<i class="bi bi-broadcast" aria-hidden="true"></i>
			<div>
				<h5>{{ sync_sites.enabled_title }}</h5>
				<p>{{ sync_sites.current_summary }}</p>
			</div>
		</div>
		<table id="{{ sync_sites.table_id }}" class="table table-striped table-bordered import-export-sites-table"></table>
	{% endif %}
</section>
