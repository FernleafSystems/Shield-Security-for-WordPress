<section class="import-export-network-setup" data-import-export-network-setup="1">
	<div class="import-export-section-intro">
		<div>
			<h5>{{ network_setup.title }}</h5>
			<p>{{ network_setup.summary }}</p>
		</div>
	</div>

	<div class="import-export-status-grid" data-import-export-network-status="1">
		{% for card in network_setup.status_cards %}
			<div class="configure-zone-card status-{{ card.status }} import-export-status-card{% if card.is_active %} is-active{% endif %}">
				<span class="configure-zone-card__icon">
					<i class="{{ card.icon_class }}" aria-hidden="true"></i>
				</span>
				<div class="configure-zone-card__body">
					<span class="configure-zone-card__title">{{ card.title }}</span>
					<div class="configure-zone-card__status">{{ card.status_label }}</div>
					<p class="configure-zone-card__oneliner">{{ card.oneliner }}</p>
				</div>
			</div>
		{% endfor %}
	</div>

	<div class="import-export-network-layout">
		<div class="import-export-setup-panel">
			<div class="import-export-panel-heading">
				<h5>{{ network_setup.setup_form.title }}</h5>
				<p>{{ network_setup.setup_form.summary }}</p>
			</div>

			{% if network_setup.has_master_url %}
				<div class="alert alert-info import-export-current-master">
					<i class="bi bi-link-45deg" aria-hidden="true"></i>
					<span>{{ network_setup.master_url_label }}: <code>{{ network_setup.current_master_url }}</code></span>
				</div>
			{% endif %}

			<form id="ImportSiteForm" class="form-horizontal icwp-wizard-form import-export-network-form">
				<div class="mb-3">
					<label class="form-label" for="{{ network_setup.setup_form.master_site_url_id }}">{{ network_setup.setup_form.master_site_url }}</label>
					<input type="url"
						   class="form-control"
						   name="{{ network_setup.setup_form.master_site_url_name }}"
						   id="{{ network_setup.setup_form.master_site_url_id }}"
						   value="{{ network_setup.current_master_url }}"
						   placeholder="{{ network_setup.setup_form.master_site_placeholder }}"
						   aria-describedby="{{ network_setup.setup_form.master_site_help_id }}" />
					<div id="{{ network_setup.setup_form.master_site_help_id }}" class="form-text">{{ network_setup.setup_form.master_site_help }}</div>
				</div>

				<div class="mb-3">
					<label class="form-label" for="{{ network_setup.setup_form.secret_key_id }}">{{ network_setup.setup_form.secret_key }}</label>
					<input type="text"
						   class="form-control"
						   maxlength="40"
						   minlength="40"
						   autocomplete="off"
						   name="{{ network_setup.setup_form.secret_key_name }}"
						   id="{{ network_setup.setup_form.secret_key_id }}"
						   placeholder="{{ network_setup.setup_form.secret_key_placeholder }}"
						   aria-describedby="{{ network_setup.setup_form.secret_key_help_id }}">
					<div id="{{ network_setup.setup_form.secret_key_help_id }}" class="form-text">{{ network_setup.setup_form.secret_key_help }}</div>
				</div>

				<fieldset class="import-export-network-choice mb-3" aria-describedby="{{ network_setup.setup_form.network_help_id }}">
					<legend class="form-label">{{ network_setup.setup_form.network_label }}</legend>
					<div class="import-export-network-choice__options">
						{% for option in network_setup.setup_form.network_options %}
							<div class="form-check">
								<input class="form-check-input"
									   type="radio"
									   name="ShieldNetwork"
									   id="{{ option.id }}"
									   value="{{ option.value }}"
									   {% if option.is_checked %}checked="checked"{% endif %}>
								<label class="form-check-label" for="{{ option.id }}">{{ option.label }}</label>
							</div>
						{% endfor %}
					</div>
					<div id="{{ network_setup.setup_form.network_help_id }}" class="form-text">{{ network_setup.setup_form.network_help }}</div>
				</fieldset>

				<div class="form-check mb-3">
					<input type="checkbox"
						   class="form-check-input"
						   name="{{ network_setup.setup_form.confirm_name }}"
						   id="{{ network_setup.setup_form.confirm_id }}"
						   value="{{ network_setup.setup_form.confirm_value }}" />
					<label for="{{ network_setup.setup_form.confirm_id }}" class="form-check-label">
						{{ network_setup.setup_form.confirm_label }}
					</label>
					<div class="form-text">{{ network_setup.setup_form.confirm_help }}</div>
				</div>

				<div class="text-end">
					<button type="submit" class="btn btn-primary import-export-primary-action">
						<i class="{{ network_setup.setup_form.submit_icon_class }}" aria-hidden="true"></i>
						<span>{{ network_setup.setup_form.submit_label }}</span>
					</button>
				</div>
			</form>
		</div>

		<div class="import-export-settings-panel">
			<div class="import-export-panel-heading">
				<h5>{{ network_setup.advanced_settings_title }}</h5>
				<p>{{ network_setup.advanced_settings_summary }}</p>
			</div>
			{{ import_export_config|raw }}
		</div>
	</div>
</section>
