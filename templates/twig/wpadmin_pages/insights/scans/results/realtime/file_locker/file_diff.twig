{% if success %}
	{% set restore_checkbox_id = 'ConfirmFileRestore-' ~ vars.rid %}
	{% set accept_checkbox_id = 'ConfirmFileAccept-' ~ vars.rid %}
	<p class="h6 my-4 ps-3">{{ strings.reviewing_locked_file }}: <code>{{ vars.full_path }}</code></p>

	{% if flags.has_diff %}

		{% if flags.original_file_missing or flags.current_content_empty  %}
			<div class="row text-center mt-4">
				<div class="alert alert-warning">
					<h4 class="h6 m-0">Warning: {{ flags.original_file_missing ? 'File is missing and cannot be read' : 'File contents are empty' }}</h4>
				</div>
			</div>
		{% endif %}
		<div class="row text-center mt-4">
			<div class="col"><h4 class="h5">{{ strings.file_content_original }}</h4></div>
			<div class="col"><h4 class="h5">{{ strings.file_content_current }}</h4></div>
		</div>
		<hr />
		<div class="row my-4">
			<div class="col">
				{% if flags.diff_available %}
					{{ html.diff|raw }}
				{% else %}
					{{ strings.diff_unavailable }}
				{% endif %}
			</div>
		</div>
	{% endif %}

	<div class="card-group">

		<div class="card">

			<div class="card-body">
				<h4 class="card-title h5">{{ strings.file_details }}</h4>

				<dl class="row">
					<dt>{{ strings.relative_path }}</dt>
					<dd>{{ vars.relative_path }}</dd>
				</dl>

				<dl class="row">
					<dt>{{ strings.locked }}</dt>
					<dd>{{ vars.locked_at }}</dd>
				</dl>

				<dl class="row">
					<dt>{{ strings.file_size }}</dt>
					<dd>{{ vars.file_size_locked }}</dd>
				</dl>

				<dl class="row">
					<dt>{{ strings.file_modified }}</dt>
					<dd>{{ vars.file_modified_ago }}<br/>({{ vars.file_modified_at }})</dd>
				</dl>

				<dl class="row">
					<dt>{{ strings.download }}</dt>
					<dd>
						<a href="{{ ajax.original }}" title="{{ strings.download }}" class="text-nowrap">
							<span class="dashicons dashicons-download"></span></a>
					</dd>
				</dl>
			</div>

		</div>

		{% if flags.has_diff %}
			<div class="card">

				<div class="card-body">
					<h4 class="card-title h5">{{ strings.modified_file }}</h4>

					<dl class="row">
						<dt>{{ strings.change_detected_at }}</dt>
						<dd>{{ vars.change_detected_at }}</dd>
					</dl>

					<dl class="row">
						<dt >{{ strings.file_size }}</dt>
						<dd >{{ vars.file_size_modified }}</dd>
					</dl>

					<dl class="row">
						<dt >{{ strings.download }}</dt>
						<dd class="col">
							<a href="{{ ajax.current }}" title="{{ strings.download }}" class="text-nowrap">
								<span class="dashicons dashicons-download"></span></a>
						</dd>
					</dl>
				</div>
			</div>

			<div class="card">
				<div class="card-body">
					<h4 class="card-title h5">{{ strings.file_restore }}</h4>
					<form class="filelocker_fileaction">
						<div class="form-check">
							<input type="checkbox" class="form-check-input me-0"
								   id="{{ restore_checkbox_id }}"
								   name="ConfirmFileRestore"
								   value="Y"
							/>
							<label class="form-check-label"
								   for="{{ restore_checkbox_id }}">{{ strings.file_restore_checkbox }}</label>
						</div>
						<input type="submit" value="{{ strings.butt_restore }}"
							   data-action="restore"
							   data-rid="{{ vars.rid }}"
							   class="btn btn-outline-success btn-sm mt-3" />
					</form>
				</div>
			</div>

			<div class="card">
				<div class="card-body">
					<h4 class="card-title h5">{{ strings.file_accept }}</h4>
					<form class="filelocker_fileaction">
						<div class="form-check">
							<input type="checkbox" class="form-check-input me-0"
								   id="{{ accept_checkbox_id }}"
								   name="ConfirmFileAccept"
								   value="Y"
							/>
							<label class="form-check-label"
								   for="{{ accept_checkbox_id }}">{{ strings.file_accept_checkbox }}</label>
						</div>
						<input type="submit" value="{{ strings.butt_accept }}"
							   data-action="accept"
							   data-rid="{{ vars.rid }}"
							   class="btn btn-outline-danger btn-sm mt-3" />
					</form>
				</div>
			</div>
		{% endif %}

	</div>
{% else %}
	<div class="alert alert-warning">{{ error }}</div>
{% endif %}
