{% import '/common/macros.twig' as icwp_macros %}
<div class="scan-item-overview">

	<dl class="scan-item-overview__facts">
		{% if vars.belongs_to is not empty %}
			<dt>{{ strings.belongs_to_label }}</dt>
			<dd>{{ vars.belongs_to }}</dd>
		{% endif %}
		<dt>{{ strings.file_full_path_label }}</dt>
		<dd><code>{{ vars.file_full_path }}</code></dd>
	</dl>

	<div class="scan-item-overview__verdict scan-item-overview__verdict--{{ vars.verdict_tone }}">
		<div class="d-flex flex-wrap gap-1 mb-2">
			{% for status in vars.file_statuses %}
				<span class="badge text-bg-{{ status.tone }}">{{ status.label }}</span>
			{% endfor %}
		</div>
		<h3 class="h6 mb-1">{{ vars.verdict_title }}</h3>
		{% if vars.verdict_note is not empty %}
			<p class="mb-1">{{ vars.verdict_note }}</p>
		{% endif %}
		{% for line in vars.file_description %}
			<p class="mb-1">{{ line }}</p>
		{% endfor %}
		{% if vars.verdict_why is not empty %}
			<details class="mt-2">
				<summary>{{ strings.malai_more }}</summary>
				{% for line in vars.verdict_why %}
					<p class="mt-2 mb-0">{{ line }}</p>
				{% endfor %}
			</details>
		{% endif %}
	</div>

	<section class="scan-item-overview__actions">
		<h4 class="scan-item-overview__actions-title">{{ strings.next_steps }}</h4>
		{% if vars.recommendations_lines is not empty %}
			<ul class="mb-2">
				{% for line in vars.recommendations_lines %}
					<li>{{ line }}</li>
				{% endfor %}
			</ul>
		{% endif %}
		<div class="d-flex flex-wrap gap-2">
			<button type="button" class="btn btn-primary btn-sm" data-scan-item-show-tab="tabDiff-tab">{{ strings.review_changes }}</button>
			<button type="button" class="btn btn-outline-primary btn-sm" data-scan-item-show-tab="tabContents-tab">{{ strings.view_contents }}</button>
			{% set download_label %}
				<i class="{{ imgs.svgs.file_download }}" aria-hidden="true"></i>
				{{ strings.file_download }}
			{% endset %}
			{{ icwp_macros.tagAnchor(hrefs.file_download, download_label, '', ['btn', 'btn-outline-primary', 'btn-sm', 'href-download'], false, [], not flags.can_download) }}
		</div>
	</section>

</div>
