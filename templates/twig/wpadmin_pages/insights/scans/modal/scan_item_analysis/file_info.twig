<div class="row">
	<div class="col scan-item-history">
		<h3 class="h4 mb-3">File: <span style="font-family: monospace">{{ vars.path_fragment|e }}</span></h3>

		<h4 class="h6">{{ strings.info|e }}</h4>
		<ul style="list-style: inside disc">
			<li>{{ strings.file_full_path_label|e }}: <code>{{ vars.file_full_path|e }}</code></li>
			<li>{{ strings.file_status_label|e }}: {{ vars.file_status|e }}</li>
		</ul>

		{% if vars.file_description is not empty %}
			<h4 class="h6">{{ strings.file_description|e }}</h4>
			<ul>
				{% for line in vars.file_description %}
					<li>{{ line|e }}</li>
				{% endfor %}
			</ul>
		{% endif %}
		{% if flags.show_malai_status %}
			<h4 class="h6">{{ strings.heading_malai_status|e }}</h4>
			<p><span class="badge text-bg-{{ vars.malware_assessment.tone|e('html_attr') }}"><i class="bi {{ vars.malware_assessment.icon|e('html_attr') }}" aria-hidden="true"></i> {{ vars.malware_assessment.label|e }}</span></p>
			<p>{{ vars.malware_assessment.summary|e }}</p>
			<p>{{ vars.malware_assessment.explanation|e }}</p>
			<p>{{ vars.malware_assessment.guidance|e }}</p>
		{% endif %}

		{% if vars.recommendations_lines is not empty %}
			<h4 class="h6">{{ strings.recommendations|e }}</h4>
			<ul>
				{% for line in vars.recommendations_lines %}
					<li>{{ line|e }}</li>
				{% endfor %}
			</ul>
		{% endif %}

	</div>
</div>
