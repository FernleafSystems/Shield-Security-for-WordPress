{% extends '/components/modals/base_modal_content.twig' %}

{% block modal_title %}
	{{ strings.modal_title }}
{% endblock %}

{% block modal_body %}
	<div data-shield-scan-modal-state="{{ vars.modal_state }}"
		 aria-busy="{{ vars.is_busy ? 'true' : 'false' }}"
		 data-shield-scan-modal-announcement="{{ vars.announcement }}">
		<h6>{{ vars.heading }}</h6>
		<p>{{ vars.remaining_scans }}</p>
		{% if vars.show_progress %}
			{% if vars.has_scan_rows %}
				<div class="d-grid gap-3">
					{% for row in vars.scan_rows %}
						<div>
							<div class="d-flex justify-content-between gap-2 mb-1">
								<div>
									<strong>{{ row.name }}</strong>
									{% if row.scope_label is not empty %}
										<div class="small text-muted">{{ row.scope_label }}</div>
									{% endif %}
								</div>
								<span class="small text-muted">{{ row.status_label }}</span>
							</div>
							<div class="progress">
								<div class="progress-bar progress-bar-striped bg-success progress-bar-animated" role="progressbar"
									 style="width: {{ row.progress }}%"
									 aria-label="{{ row.aria_label }}"
									 aria-valuenow="{{ row.progress }}" aria-valuemin="0" aria-valuemax="100">
								</div>
							</div>
						</div>
					{% endfor %}
				</div>
			{% else %}
				<div class="progress">
					<div class="progress-bar progress-bar-striped bg-success progress-bar-animated" role="progressbar"
						 style="width: {{ vars.progress }}%"
						 aria-label="{{ strings.progress_label }}"
						 aria-valuenow="{{ vars.progress }}" aria-valuemin="0" aria-valuemax="100">
					</div>
				</div>
			{% endif %}
			<p class="mt-2">{{ strings.patience_1 }}
				{{ strings.patience_2 }}
			</p>
		{% endif %}
	</div>
{% endblock %}
