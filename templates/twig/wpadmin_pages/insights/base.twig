{% extends '/wpadmin_pages/base.twig' %}

{% block page_head %}

	{% if strings.top_page_warnings is not empty %}
		<div id="ShieldTopPageWarnings" class="row row-cols-1 gx-2">
					{% for warning in strings.top_page_warnings %}
						<div class="col apto-top_page_warning bg-{{ warning.type }} py-1 border-bottom shield-notice-container"
							 data-notice_id="{{ warning.id }}">
					{% for each_line in warning.text %}<p class="my-1 text-center">{{ each_line|raw }}</p>{% endfor %}
					{% if warning.can_dismiss %}
						<p class="my-1 text-center"><button type="button" class="shield-topwarning-dismiss shield-button-link text-reset">{{ strings.dismiss_notice }}</button></p>
					{% endif %}
				</div>
			{% endfor %}
		</div>
	{% endif %}
{% endblock %}

{% block page_main %}
{% endblock %}

{% block page_foot %}
{% endblock %}
