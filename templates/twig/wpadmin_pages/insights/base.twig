{% extends '/wpadmin_pages/base.twig' %}

{% block page_head %}

	{% if strings.top_page_warnings is not empty %}
		<div id="ShieldTopPageWarnings" class="row row-cols-1 gx-2">
					{% for warning in strings.top_page_warnings %}
						<div class="col apto-top_page_warning bg-{{ warning.type }} py-1 border-bottom shield-notice-container"
							 data-notice_id="{{ warning.id }}">
					{# Dismissing a notice is offered at the end of its last line, so a one-line notice stays on one line. #}
					{% for each_line in warning.text %}<p class="my-1 text-center">{{ each_line|raw }}{% if loop.last and warning.can_dismiss %}
						<button type="button" class="shield-topwarning-dismiss shield-button-link text-reset text-decoration-underline ms-2">{{ strings.dismiss_notice }}</button>{% endif %}</p>{% endfor %}
				</div>
			{% endfor %}
		</div>
	{% endif %}
{% endblock %}

{% block page_main %}
{% endblock %}

{% block page_foot %}
{% endblock %}
